# HTTPS consumer base URL of the running control plane (not ws:// or wss://).
GPU_POOL_URL=https://pool.example.com

# Backend/consumer API key. Do not put the node token here.
GPU_POOL_API_KEY=replace-with-your-api-key

# Optional: override the default repository data/ folder.
VGPU_DATA_DIR=

# Optional: absolute path to an already-mounted Google Drive folder.
# Leave empty to keep all recovery state and artifacts only on this computer.
VGPU_DRIVE_DIR=
